# =============================================================================
# Enterprise Knowledge Copilot — configuration
# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real API keys.
# =============================================================================

# ---- LLM (answer generation) ------------------------------------------------
# extractive : local mode, no API key, answers are quoted sentences from sources
# openai     : OpenAI or any OpenAI-compatible API (Groq, OpenRouter, Ollama, vLLM)
LLM_PROVIDER=extractive
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
# Put your key here (only needed for LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=
# Leave empty for api.openai.com. Examples:
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Ollama:     http://host.docker.internal:11434/v1   (any non-empty OPENAI_API_KEY)
OPENAI_BASE_URL=

# ---- Embeddings ---------------------------------------------------------------
# sentence-transformers : local model, free (downloaded once, ~90 MB)
# openai                : e.g. EMBEDDING_MODEL=text-embedding-3-small
# hash                  : offline lexical fallback for tests / no-download setups
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# ---- Chunking -----------------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# ---- Retrieval ----------------------------------------------------------------
TOP_K=5
# Minimum cosine similarity for a passage to be used.
# ~0.25 suits all-MiniLM-L6-v2; use ~0.1 with EMBEDDING_PROVIDER=hash.
SIMILARITY_THRESHOLD=0.25
# vector = semantic only, hybrid = semantic + BM25 keyword (Reciprocal Rank Fusion)
RETRIEVAL_MODE=vector
HYBRID_ALPHA=0.5
# none or cross-encoder (needs sentence-transformers)
RERANKER=none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# ---- Conversation ---------------------------------------------------------------
CONVERSATION_HISTORY_TURNS=6
REWRITE_FOLLOW_UP_QUESTIONS=true

# ---- Evaluation -----------------------------------------------------------------
# heuristic (deterministic) or llm (LLM-as-judge, needs LLM_PROVIDER=openai)
EVALUATION_JUDGE=heuristic

# ---- Storage (defaults shown; Docker overrides DATA_DIR to /app/storage) ----------
# DATA_DIR=./storage
# DATABASE_URL=sqlite:///./storage/copilot.db
# CHROMA_PERSIST_DIR=./storage/chroma
# UPLOAD_DIR=./storage/uploads

# ---- Upload limits ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25

# ---- Server -----------------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---- Docker -----------------------------------------------------------------------
FRONTEND_PORT=8080
BACKEND_PORT=8000
# false = slim backend image without PyTorch (use EMBEDDING_PROVIDER=openai or hash)
INSTALL_LOCAL_MODELS=true
